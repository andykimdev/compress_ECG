# Patient data must never be committed (PhysioNet data use agreement)
data/
*.npy
*.npz
*.csv
!results/**/*.csv

# Third-party code, model weights, and run outputs
external/
checkpoints/
*.pt
*.pt2
*.pth
*.onnx
*.engine
*.joblib
wandb/
runs/
results/dummy_audit/
# Aggregate tables may be committed, but per-ECG predictions, metadata, and caches may not.
results/**/predictions/
results/**/metadata.csv
results/student/mini_cache/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/
build/
dist/

# Local secrets and OS files
.env
.DS_Store
